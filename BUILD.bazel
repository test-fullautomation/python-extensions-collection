# =============================================================================
# python-extensions-collection/BUILD.bazel
# =============================================================================
#
# This package builds the "PythonExtensionsCollection" package directly
# from its GitHub repository source (see MODULE.bazel: git_repository
# "python_extensions_collection_src").
#
# Proxy Configuration:
#   Proxy settings are inherited from the environment via .bazelrc.
#   Set HTTPS_PROXY, HTTP_PROXY, and NO_PROXY environment variables
#   before running bazel build.
#
# =============================================================================

load("@pip_utils//:pip_install.bzl", "pip_install_from_source")
load("@rules_python//python:defs.bzl", "py_binary")

# Build/install PythonExtensionsCollection from the GitHub source tree
# fetched via git_repository (see MODULE.bazel), together with its
# transitive PyPI dependencies - ONE single Bazel target (see
# pip_install.bzl's pip_install_from_source "requirements" attribute doc
# for why this no longer requires a separate sibling pip_install_dir
# "_deps" target).
pip_install_from_source(
    name         = "python_extensions_collection",
    source       = "@python_extensions_collection_src//:src",
    requirements = "requirements_lock.txt",
    interpreter  = "@python//:python_interpreter",
    runtime      = "@python//:python_runtime",
    # No explicit env needed - proxy variables are inherited via --action_env
    # NOTE: Public visibility required - granting "@installer//:__pkg__" here
    # would force this module to bazel_dep(installer), but installer already
    # bazel_dep's this module, creating a circular dependency. Access control
    # is enforced via the one-directional bazel_dep graph instead.
    visibility = ["//visibility:public"],
)

# Linux counterpart of the target above, for debian_package-based installer variants.
# Same source tree, but its OWN separate requirements_lock_linux.txt (not
# the Windows requirements_lock.txt) - a distinct, independently
# version-controlled lock file per platform avoids a single shared file
# whose hashes are only valid for one OS.
#
# ponytail: requirements_lock_linux.txt currently still holds a COPY of
# the Windows-hash-pinned requirements_lock.txt content - a real Linux
# rollout needs this file regenerated via `bazel run
# //:update_requirements_lock_linux` on an actual Linux host.
pip_install_from_source(
    name         = "python_extensions_collection_linux",
    source       = "@python_extensions_collection_src//:src",
    requirements = "requirements_lock_linux.txt",
    interpreter  = "@python//:python_interpreter_linux",
    runtime      = "@python//:python_runtime_linux",
    visibility = ["//visibility:public"],
)

# =============================================================================
# requirements_lock.txt maintenance ("bazel run", NOT part of "bazel build")
# =============================================================================
# Regenerates this component's hash-pinned lock file via pip-compile
# (pip-tools) - see python-jsonpreprocessor/BUILD.bazel's identical target
# for the full rationale (pip-compile needs network access and is
# therefore deliberately a "bazel run" py_binary, not a build action).
#
#   bazel run //:update_requirements_lock          # Windows lock file
#   bazel run //:update_requirements_lock_linux     # Linux lock file -
#                                                    # run this ON A LINUX
#                                                    # HOST.
#
py_binary(
    name = "update_requirements_lock",
    srcs = ["@pip_utils//:update_requirements_lock.py"],
    main = "@pip_utils//:update_requirements_lock.py",
    # See python-jsonpreprocessor/BUILD.bazel's identical comment for why
    # precompilation is disabled here.
    precompile = "disabled",
    data = [
        "@python//:python_interpreter",
        "pyproject.toml",
        "requirements_build_extras.txt",
    ],
    args = [
        "--interpreter=$(location @python//:python_interpreter)",
        "--component-dir=python-extensions-collection",
        "--output=requirements_lock.txt",
        "pyproject.toml",
        "requirements_build_extras.txt",
    ],
)

py_binary(
    name = "update_requirements_lock_linux",
    srcs = ["@pip_utils//:update_requirements_lock.py"],
    main = "@pip_utils//:update_requirements_lock.py",
    # See update_requirements_lock's identical comment above.
    precompile = "disabled",
    data = [
        "@python//:python_interpreter_linux",
        "pyproject.toml",
        "requirements_build_extras.txt",
    ],
    args = [
        "--interpreter=$(location @python//:python_interpreter_linux)",
        "--component-dir=python-extensions-collection",
        "--output=requirements_lock_linux.txt",
        "pyproject.toml",
        "requirements_build_extras.txt",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)